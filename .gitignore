**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*.old
**/*~
.DS_Store
Thumbs.db

# Disposable application copies for isolated E2E; never commit credentials or dependencies.
/.e2e-e23/

# Academic evidence contains generated traces, screenshots, exports, and archives.
# Keep it on disk, but review files individually before sharing outside this project.
/evidencias/
